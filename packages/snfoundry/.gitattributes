# conflicting patterns by last-match-wins, so listing them first (as before)
# let contracts/** silently override them back to merge=ours.
contracts/Scarb.lock merge=theirs
contracts/Scarb.toml merge=theirs

scripts-ts/deploy.ts merge=ours